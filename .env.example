# ---------------------------------------------------------------------------
# Mutqin for Men application (Supabase project uaublandjewfzmhnbflc — never the Sisters project)
# ---------------------------------------------------------------------------
# The browser needs only these two values (same as Mutqin for Sisters). Put them in .env.local.
# Either name form works; Vite exposes ONLY these two values to the browser.
SUPABASE_URL=""                 # or VITE_SUPABASE_URL
SUPABASE_PUBLISHABLE_KEY=""     # or VITE_SUPABASE_PUBLISHABLE_KEY (public by design)

# ---------------------------------------------------------------------------
# Migration / admin tooling only — never needed by the running application, never sent to browsers
# ---------------------------------------------------------------------------
# SUPABASE_SECRET_KEY=""               # Auth admin (link-auth.mjs, smoke.ts, parity.ts)
# MEN_MIGRATION_DATABASE_URL=""        # owner connection for migrations (apply-migration.mjs)
# MEN_CUTOVER_APPROVED_PROJECT=""      # set to the project ref only when a write step is approved
# GOOGLE_APPLICATION_CREDENTIALS=""    # read-only Firestore export (service account file outside the repo)

# Edge Functions get SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY from the Supabase platform automatically.

# Optional (unrelated to Supabase): Gemini key injected by AI Studio, unused by the current code.
# GEMINI_API_KEY=""
