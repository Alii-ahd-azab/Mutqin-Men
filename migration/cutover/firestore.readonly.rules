rules_version = '2';
// Phase J (post-cutover): Firestore becomes a read-only rollback/reference copy of Mutqin for Men.
// Deploy only after the Supabase application is live:
//   firebase deploy --only firestore:rules --project mutqin-7f0bb   (with this file as the rules source)
// Every write through client SDKs — including the legacy server account — is denied.
// Firebase Admin SDK reads used by migration/export.mjs are not subject to rules and keep working.
// Rollback: redeploy the archived rules (migration/archive/firebase/firestore.rules) with the old application.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if request.auth != null && request.auth.token.email == 'herotero13@gmail.com';
      allow write: if false;
    }
  }
}
