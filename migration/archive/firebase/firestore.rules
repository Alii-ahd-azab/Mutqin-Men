rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Identifies server service account or verified admin account
    function isServerOrAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'herotero13@gmail.com' ||
        request.auth.token.firebase.sign_in_provider == 'custom' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isMember() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'member';
    }

    // 1. DEFAULT DENY ALL: Blocks any random unauthenticated or unauthorized client
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. USERS: Only server or verified admin can write/create/delete members.
    // Random clients without authentication have zero access.
    match /users/{userId} {
      allow read: if isServerOrAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow create, update, delete: if isServerOrAdmin();
    }

    // 3. SETTINGS: Only server or admin can modify plan and dates.
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isServerOrAdmin();
    }

    // 4. REST DAYS: Only server or admin can add/delete rest days.
    match /rest_days/{restDayId} {
      allow read: if isSignedIn();
      allow write: if isServerOrAdmin();
    }

    // 5. RECITATIONS: Must satisfy mutual recitation integrity
    // Reciter cannot be the listener; random clients blocked.
    match /recitations/{recitationId} {
      allow read: if isSignedIn();
      allow create: if isServerOrAdmin() || (
        isMember() &&
        request.resource.data.listener_id == request.auth.uid &&
        request.resource.data.reciter_id != request.auth.uid
      );
      allow update, delete: if isServerOrAdmin();
    }

    // 6. REVISIONS: Members can only submit their own daily revision
    match /revisions/{revisionId} {
      allow read: if isSignedIn();
      allow create, update: if isServerOrAdmin() || (
        isMember() &&
        request.resource.data.member_id == request.auth.uid
      );
      allow delete: if isServerOrAdmin();
    }

    // 7. TESTS: Admin creates/updates tests, all signed-in users can read
    match /tests/{testId} {
      allow read: if isSignedIn();
      allow write: if isServerOrAdmin();
    }

    // 8. TEST ATTEMPTS: Peer testing integrity
    // Examiner tests candidate (examiner cannot test themselves)
    match /test_attempts/{attemptId} {
      allow read: if isSignedIn();
      allow create: if isServerOrAdmin() || (
        isMember() &&
        request.resource.data.examiner_id == request.auth.uid &&
        request.resource.data.candidate_id != request.auth.uid
      );
      allow update, delete: if isServerOrAdmin();
    }

    // 9. PERSONAL TESTS: private self-tests of members (اختبر نفسك)
    match /personal_tests/{recordId} {
      allow read: if isServerOrAdmin() || (
        isSignedIn() && resource.data.member_id == request.auth.uid
      );
      allow create: if isServerOrAdmin() || (
        isSignedIn() && request.resource.data.member_id == request.auth.uid
      );
      allow update, delete: if isServerOrAdmin() || (
        isSignedIn() && resource.data.member_id == request.auth.uid
      );
    }
  }
}


